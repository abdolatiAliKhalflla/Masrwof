@page "/expense/{action}"
@page "/expense/{action}/{id:guid}"

@inject IExpenseService ExpenseService
@inject NavigationManager Navigation

<div class="expense-form-container">
    <EditForm Model="@expense" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="expense-form-group">
            <label class="expense-form-label">المصروف</label>
            <input type="text" class="expense-form-input" @bind-value="expense.Name" disabled="@isReadOnly" required />
        </div>

        <div class="expense-form-group">
            <label class="expense-form-label">المبلغ (د.ل)</label>
            <input type="number" step="0.01" class="expense-form-input" @bind-value="expense.Amount" disabled="@isReadOnly" required />
        </div>

        <div class="expense-form-group">
            <label class="expense-form-label">الفئة</label>
            <select class="expense-form-input" @bind="expense.Category" disabled="@isReadOnly">
                <option value="طعام">طعام</option>
                <option value="مواصلات">مواصلات</option>
                <option value="فواتير">فواتير</option>
                <option value="ترفيه">ترفيه</option>
                <option value="صحة">صحة وعلاج</option>
                <option value="أخرى">أخرى</option>
            </select>
        </div>

        <div class="expense-form-group">
            <label class="expense-form-label">التاريخ</label>
            <input type="date" class="expense-form-input" @bind-value="expense.Date" disabled="@isReadOnly" />
        </div>

        @if (isReadOnly)
        {
            <div class="expense-summary">
                <span>إجمالي القيمة:</span>
                <strong>@expense.Amount.ToString("C2", CultureInfo.GetCultureInfo("ar-LY"))</strong>
            </div>
        }

        <div class="expense-actions">
            @if (!isReadOnly)
            {
                <button type="submit" class="expense-btn expense-btn-primary">
                    @(Action.Equals("edit", StringComparison.OrdinalIgnoreCase) ? "حفظ" : "إضافة")
                </button>
            }
            <button type="button" class="expense-btn" @onclick="GoBack">
                @(isReadOnly ? "رجوع" : "إلغاء")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public string Action { get; set; } = "add";
    [Parameter] public Guid? Id { get; set; }

    private Expense expense = new();
    private bool isReadOnly;

    protected override void OnInitialized()
    {
        isReadOnly = Action.Equals("view", StringComparison.OrdinalIgnoreCase);

        if (Id.HasValue && !Action.Equals("add", StringComparison.OrdinalIgnoreCase))
        {
            expense = ExpenseService.GetExpenseById(Id.Value) ?? new();
            if (expense.Id == Guid.Empty) Navigation.NavigateTo("/expenses");
        }
        else
        {
            expense = new Expense { Date = DateTime.Now, Category = "طعام" };
        }
    }

    private void HandleSubmit()
    {
        if (Action.Equals("edit", StringComparison.OrdinalIgnoreCase))
            ExpenseService.UpdateExpense(expense);
        else
            ExpenseService.AddExpense(expense);

        GoBack();
    }

    private void GoBack() => Navigation.NavigateTo("/expenses");
}